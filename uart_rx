`timescale 1ns / 1ns

module uart_rx(
    input wire clk,
    input wire rst,
    input wire rx,
    output reg [7:0] data_out,
    output reg data_valid
);

parameter baud_tick = 5208;

parameter IDLE = 2'b00, START = 2'b01, DATA = 2'b10, STOP = 2'b11;
reg [1:0] state;

reg [12:0] baud_count = 0;
reg [2:0] bit_count = 0;
reg [7:0] data_buffer = 0;
reg rx_sync;

always @(posedge clk) rx_sync <= rx;


always @(posedge clk) begin
    if (rst) begin
        state <= IDLE;
        baud_count <= 0;
        bit_count <= 0;
        data_valid <= 0;
        data_out <= 0;
    end else begin
        data_valid <= 0; // default

        case (state)
            IDLE: begin
                if (rx_sync == 0) begin
                    state <= START;
                    baud_count <= 0;
                end
            end

            START: begin
                if (baud_count == (baud_tick / 2)) begin
                    if (rx_sync == 0) begin
                        state <= DATA;
                        bit_count <= 0;
                        baud_count <= 0;
                    end else state <= IDLE;
                end else begin
                    baud_count <= baud_count + 1; // Move increment here
                end
            end

            DATA: begin
                if (baud_count == baud_tick - 1) begin
                    data_buffer[bit_count] <= rx_sync;
                    baud_count <= 0;
                    if (bit_count == 7)
                        state <= STOP;
                    else
                        bit_count <= bit_count + 1;
                end else begin
                    baud_count <= baud_count + 1; // Move increment here
                end
            end

            STOP: begin
                if (baud_count == baud_tick - 1) begin
                    state <= IDLE;
                    data_out <= data_buffer;
                    data_valid <= 1;
                    baud_count <= 0;
                end else begin
                    baud_count <= baud_count + 1; // Move increment here
                end
            end
        endcase
    end
end

endmodule
